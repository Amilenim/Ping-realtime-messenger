@model Ping.Models.ProfileViewModel

@{
    bool hasPasswordErrors = !ViewData.ModelState.IsValid &&
        (ViewData.ModelState.ContainsKey("CurrentPassword") && ViewData.ModelState["CurrentPassword"].Errors.Count > 0 ||
         ViewData.ModelState.ContainsKey("NewPassword") && ViewData.ModelState["NewPassword"].Errors.Count > 0 ||
         ViewData.ModelState.ContainsKey("ConfirmPassword") && ViewData.ModelState["ConfirmPassword"].Errors.Count > 0);

    string passwordSectionDisplay = hasPasswordErrors ? "block" : "none";
    string toggleButtonText = hasPasswordErrors ? "Відмінити зміну профілю" : "Змінити пароль";

    int hash = 0;
    string safeName = Model.Name ?? "U";
    foreach (char c in safeName) { hash = c + ((hash << 5) - hash); }
    int hue = Math.Abs(hash % 360);
    string avatarColor = $"hsl({hue}, 60%, 50%)";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@21.0.7/build/css/intlTelInput.css">

<div class="profile-settings-wrapper">
    <div class="profile-card">

        <div class="text-center mb-4 d-flex flex-column align-items-center">
            <div class="tg-avatar-wrapper mb-3" id="avatarWrapper">
                <input type="file" id="avatarInput" accept="image/*" style="display: none;" />
                <div id="avatarContent" class="w-100 h-100">
                    @if (!string.IsNullOrEmpty(Model.AvatarPath))
                    {
                        <img src="@Model.AvatarPath" class="tg-avatar-img" alt="Avatar" />
                    }
                    else
                    {
                        <div class="tg-avatar-letters" style="background-color: @avatarColor;">
                            @safeName.Substring(0, 1).ToUpper()
                        </div>
                    }
                </div>
                <div class="tg-avatar-overlay">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                </div>
            </div>

            <h4 class="fw-bold m-0">Налаштування профілю</h4>
        </div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success text-center py-2 mb-3">
                ✨ @ViewBag.SuccessMessage
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 mb-3">
                <div asp-validation-summary="All" class="text-danger m-0 list-unstyled"></div>
            </div>
        }

        <form method="post" action="/Settings/Settings" data-skip-phone-validation="true" onsubmit="event.preventDefault(); submitProfileSettings(this);">

            <div class="custom-input-group mb-3">
                <label class="text-muted small mb-1 d-block">Ваше ім'я</label>
                <div class="position-relative d-flex align-items-center">
                    <input asp-for="Name" id="profileName" class="elegant-input w-100" readonly required autocomplete="off" />
                    <button type="button" class="pencil-btn" onclick="toggleEdit(this, 'profileName')">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </button>
                </div>
            </div>

            <div class="custom-input-group mb-3">
                <label class="text-muted small mb-1 d-block">Ім'я користувача (ID)</label>
                <div class="position-relative d-flex align-items-center">
                    <input asp-for="Username" id="profileUsername" class="elegant-input w-100" readonly required autocomplete="off" />
                    <button type="button" class="pencil-btn" onclick="toggleEdit(this, 'profileUsername')">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </button>
                </div>
            </div>

            <div class="custom-input-group mb-4">
                <label class="text-muted small mb-1 d-block">Номер телефону</label>
                <div class="position-relative d-flex align-items-center">
                    <input asp-for="PhoneNumber" id="profilePhone" type="tel" class="elegant-input w-100" readonly required autocomplete="off" />
                    <button type="button" class="pencil-btn" onclick="toggleEdit(this, 'profilePhone')">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </button>
                </div>
                <div id="phoneJsError" class="phone-error">Неверный формат номера</div>
            </div>

            <hr class="divider" />

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="security-label">Безпека</h6>
                <button type="button" id="passwordToggleBtn" class="password-toggle-btn btn btn-link" onclick="togglePasswordSection()">
                    @toggleButtonText
                </button>
            </div>

            <div id="passwordSection" style="display: @passwordSectionDisplay;">
                <div class="mb-3">
                    <label class="text-muted small mb-1">Діючий пароль</label>
                    <input asp-for="CurrentPassword" type="password" class="form-control elegant-form-control" placeholder="••••••••" autocomplete="new-password" />
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="text-muted small mb-1">Новий пароль</label>
                        <input asp-for="NewPassword" type="password" class="form-control elegant-form-control" placeholder="Новий" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="text-muted small mb-1">Підтвердження</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control elegant-form-control" placeholder="Щє раз" />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-save w-100 mt-3 py-2 fw-bold">
                Зберігти зміни
            </button>
        </form>
    </div>
</div>

<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@21.0.7/build/js/intlTelInput.min.js"></script>
